{:paths ["src"]
 ;; The actor itself is dependency-free: `feedops.operation` is a pure
 ;; function that takes the governor fn directly, so there is no
 ;; langgraph on the runtime path (`feedops.sim` is still a stub).
 ;; jp-go-digital-design-system is needed only to style the generated
 ;; operator console (`:render-html`); it is a leaf, cljc, no-native dep.
 :deps {io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}}
  :run {:main-opts ["-m" "feedops.sim"]}
  ;; clojure -M:dev:render-html [out-file]
  ;; -> regenerate docs/samples/operator-console.html by driving the real
  ;;    operation -> governor -> store stack (flagship checklist item 2).
  :render-html {:main-opts ["-m" "feedops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
